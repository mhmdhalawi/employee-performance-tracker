# Copy to .env and fill in.

OPENAI_API_KEY=
APP_DEBUG=false

# JSON list — must be valid JSON, not a bare comma-separated string.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local SQLite database. Keep this on local disk, not a network filesystem.
DATABASE_PATH=storage/tracker.sqlite3

# Set false in production to disable /docs, /redoc, and /openapi.json.
DOCS_ENABLED=true
