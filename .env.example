# Copy to .env and fill in. The service runs without a key — AI reports then
# fall back to a deterministic template summary.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30

# Column-mapping agent. Off = hybrid/ai upload modes fall back to alias matching.
AI_MAPPING_ENABLED=true
AI_MAPPING_LOW_CONFIDENCE=0.6

DEBUG=false

# JSON list — must be valid JSON, not a bare comma-separated string.
CORS_ORIGINS=["http://localhost:5173"]

MAX_UPLOAD_BYTES=10485760
