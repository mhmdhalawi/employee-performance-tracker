# Copy to .env and fill in.

OPENAI_API_KEY=

# JSON list — must be valid JSON, not a bare comma-separated string.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Authentication is process-local. Sessions expire after 30 minutes and are
# cleared whenever the backend restarts.
AUTH_EMAIL=
AUTH_PASSWORD=
AUTH_SESSION_TTL_SECONDS=1800
AUTH_SESSION_MAX_ENTRIES=128
AUTH_COOKIE_NAME=tracker_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Set false in production to disable /docs, /redoc, and /openapi.json.
DOCS_ENABLED=true
